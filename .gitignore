# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
.venv/
venv/
env/
.python-version

# Environment
.env
.env.local
.env.*.local
# Rotating a token writes .env.bak.<epoch> next to it; .env alone doesn't match those.
.env.bak*
.env.backup
.env.old
.env.save

# Editor
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Local state
data/
*.db
*.db-journal
*.sqlite
*.sqlite3
*.log

# Build / dist
build/
dist/
*.egg

# Tooling caches
.ruff_cache/
.pytest_cache/
.mypy_cache/
.pyright/

# Coverage
.coverage
.coverage.*
htmlcov/
coverage.xml

# Secret material
*.pem
*.key
id_rsa*

# Backup and merge artifacts
*.bak
*.orig
*.rej

# Claude Code per-machine settings (the shared .claude/settings.json may still be committed)
.claude/settings.local.json
.claude/worktrees/
.claude/PHASE_*.md
.claude/plans/
.claude/agent-memory-local/
# Per-machine harness state. These were only in .git/info/exclude, which no clone gets.
.claude/scheduled_tasks.json
.claude/scheduled_tasks.lock
.claude/routines/.state/
.claude/checkpoints/
.claude/mailbox/
.claude/agent-registry.json
.claude/first-run
.claude/assistant-daemon-state.json
